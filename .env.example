# autius account (used by check + discover)
AUTIUS_EMAIL=you@example.com
AUTIUS_PASSWORD=your-password

# discord incoming webhook url
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# optional: override api bases (defaults match the live app)
# AUTIUS_API_BASE=https://api.autius.com/api/v1
# AUTIUS_AUTH_BASE=https://api.autius.com
